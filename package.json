{
  "name": "todolist",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "predev": "node scripts/start-db.mjs",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "db:up": "node scripts/start-db.mjs",
    "db:down": "docker compose down",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
